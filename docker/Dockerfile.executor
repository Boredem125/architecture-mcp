FROM python:3.12-slim AS builder

WORKDIR /build
COPY pyproject.toml .
COPY src/ src/

RUN pip install --no-cache-dir --prefix=/install .

FROM python:3.12-slim

RUN groupadd -r executor && useradd -r -g executor -u 10001 -s /sbin/nologin executor

COPY --from=builder /install /usr/local

RUN mkdir -p /tmp/workspace && chown executor:executor /tmp/workspace

WORKDIR /app
USER executor

ENTRYPOINT ["python", "-m", "sandbox.agents.executor"]
